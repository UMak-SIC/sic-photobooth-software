[connection]
id={{SSID}}
uuid=ed589c97-b0de-4f0d-9d8e-0e8f75cc5a85
type=wifi
interface-name={{WIFI_INTERFACE}}
autoconnect=false

[wifi]
mode=ap
ssid={{SSID}}

[wifi-security]
key-mgmt=wpa-psk
psk={{HOTSPOT_PASSWORD}}

[ipv4]
method=manual
address1={{GATEWAY_IP}}/{{SUBNET_PREFIX}}

[ipv6]
method=disabled
