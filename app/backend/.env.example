# The booth's SQLite database. Use a new versioned file per cutover; never switch files
# while the backend or a worker is running (docs/runbooks/sqlite-backup-and-restore.md).
SQLITE_DATABASE_PATH=./storage/database/photobooth.sqlite

# Cutover validation hold (docs/runbooks/postgres-to-sqlite-cutover.md). When "1",
# non-GET/HEAD/OPTIONS routes return 503 and the publishing/print workers stay stopped.
# Accepted values: 1, true, 0, false. Remove or set to 0 only by explicit operator action.
DATABASE_CUTOVER_HOLD=0

PORT=3000
HOST=0.0.0.0
STORAGE_DIR=./storage
