# PostgreSQL remains the default production engine until an approved SQLite cutover.
LOCAL_DATABASE_ENGINE=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photobooth

# Used only when LOCAL_DATABASE_ENGINE=sqlite during development or a validated rehearsal.
SQLITE_DATABASE_PATH=./storage/database/photobooth.sqlite

PORT=3000
HOST=0.0.0.0
STORAGE_DIR=./storage
